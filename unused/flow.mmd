%%{init: {'theme': 'dark', 'themeVariables': { 'fontSize': '14px', 'fontFamily': 'monospace' }}}%%
graph TB
    subgraph EXTERNAL["EXTERNAL"]
        AUTONOM["Autonom Oracle API<br/>178.128.21.71:3000<br/>Gold · Silver · Oil · Platinum"]
        USER["User / MetaMask Wallet"]
    end

    subgraph ORACLE_SERVICE["ORACLE SERVICE · TypeScript · Node.js"]
        FETCHER["Fetcher<br/>0.5s polling"]
        PRICESTORE["PriceStore<br/>OHLCV candles"]
        CHAINPUSHER["ChainPusher<br/>abi.encode + ECDSA<br/>+ post-push hooks"]
        MARKETDETECTOR["MarketStateDetector<br/>fresh flag · debounce<br/>+ cooldown"]
        WSSERVER["WebSocket Server<br/>ws://localhost:8080<br/>prices · state · positions"]
        RESTAPI["REST API<br/>localhost:3001<br/>candles · positions · health"]

        subgraph KEEPERS["Keepers (tick-based, not polling)"]
            COORDINATOR["KeeperCoordinator<br/>settlement lock"]
            FAK["FeeAccrualKeeper<br/>every 15s (throttled)"]
            LE["LiquidationEngine<br/>off-chain pre-check<br/>+ parallel liquidate()"]
            PT["PositionTracker<br/>DB-backed + live watch<br/>Trading + P2P events"]
            PSK["P2PSettlementKeeper<br/>batch settle (50/tx)<br/>+ sweep leftover"]
            PR["PositionReconciler<br/>30-min DB↔chain sweep"]
        end
    end

    subgraph DATABASE["POSTGRESQL · localhost:5432"]
        DB_TICKS["PriceTick"]
        DB_CANDLES["Candle"]
        DB_POSITIONS["PositionRecord<br/>open → close/liquidate/settle"]
        DB_MARKET["MarketStateLog"]
        DB_KEEPER["KeeperEvent"]
    end

    subgraph FRONTEND["FRONTEND · Next.js · localhost:3000"]
        TRADEPAGE["Trade Page<br/>OrderPanel · PositionList"]
        POOLPAGE["Pool Page<br/>Deposit · Withdraw · Stats"]
        GOVPAGE["Governance Page<br/>Propose · Vote · Execute"]
        CHART["TradingView Charts<br/>Lightweight Charts v4<br/>1m–1Y intervals"]
    end

    subgraph CONTRACTS["SMART CONTRACTS · Solidity · Anvil :8545"]
        ORACLE_SOL["Oracle.sol<br/>abi.encode + ECDSA<br/>210s staleness"]
        MARKETSTATE["MarketState.sol<br/>per-feed open/close"]
        TRADING["Trading.sol<br/>open · close · addCollateral · liquidate<br/>10% maintenance margin<br/>fee-then-size model<br/>300s min open time"]
        P2PTRADING["P2PTrading.sol<br/>off-hours escrow<br/>VAMM pricing<br/>10s min open time"]
        VAMM["VAMM.sol<br/>x·y=k virtual AMM<br/>depth multiplier"]
        FEEMANAGER["FeeManager.sol<br/>0.1% open/close fee<br/>5 bps/hr base + funding<br/>LP/protocol 90/10 split"]
        POOL["Pool.sol<br/>LP accounting<br/>PMLP mint/burn<br/>checks-effects-interactions"]
        GOVERNANCE["Governance.sol<br/>PRPMAN voting<br/>48h · 20% quorum"]

        subgraph CUSTODIES["Custodies · All USDC Lives Here"]
            CUSTODY_GOLD["Gold Custody<br/>feed 2056<br/>totalTraderCollateral tracked"]
            CUSTODY_SILVER["Silver Custody<br/>feed 2069<br/>lpLiquidity() for fee rates"]
            CUSTODY_OIL["CrudeOil Custody<br/>feed 2003<br/>sizeUsd reservation"]
            CUSTODY_PLAT["Platinum Custody<br/>feed 2062<br/>GMX-style accumulators"]
        end

        subgraph TOKENS["Tokens"]
            USDC["MockUSDC<br/>18 decimals"]
            PMLP["PMLP<br/>LP receipt"]
            PRPMAN["PRPMAN<br/>governance"]
        end
    end

    %% Price Flow: Autonom → Fetcher → pipeline
    AUTONOM -->|"HTTP batch poll<br/>every 0.5s"| FETCHER
    FETCHER --> PRICESTORE
    FETCHER --> MARKETDETECTOR
    FETCHER --> CHAINPUSHER
    PRICESTORE --> WSSERVER
    PRICESTORE --> RESTAPI
    PRICESTORE -->|"async persist"| DB_TICKS
    PRICESTORE -->|"async upsert"| DB_CANDLES

    %% Chain pusher → Oracle + post-push hooks
    CHAINPUSHER -->|"signed tx<br/>abi.encode"| ORACLE_SOL
    CHAINPUSHER -->|"post-push<br/>if ≥15s"| FAK
    CHAINPUSHER -->|"post-push<br/>every tick"| LE

    %% Market state detection → keepers + DB
    MARKETDETECTOR -->|"CLOSED→OPEN"| PSK
    MARKETDETECTOR -->|"OPEN→CLOSED<br/>initializeVAMM"| VAMM
    MARKETDETECTOR -->|"log transition"| DB_MARKET

    %% Fee accrual → custodies
    FAK -->|"accrueFees()"| CUSTODY_GOLD
    FAK -->|"accrueFees()"| CUSTODY_SILVER
    FAK -->|"accrueFees()"| CUSTODY_OIL
    FAK -->|"accrueFees()"| CUSTODY_PLAT

    %% Liquidation engine
    PT -->|"positions feed"| LE
    PT -->|"watchContractEvent"| TRADING
    PT -->|"watchContractEvent"| P2PTRADING
    PT -->|"persist/update"| DB_POSITIONS
    LE -->|"read accumulators"| CUSTODY_GOLD
    LE -->|"Trading.liquidate()"| TRADING
    LE -.->|"skip if locked"| COORDINATOR

    %% Reconciler
    PR -->|"verify open positions"| DB_POSITIONS
    PR -->|"check on-chain"| TRADING
    PR -->|"log sweep"| DB_KEEPER

    %% P2P settlement keeper
    PSK -->|"startSettlement()"| COORDINATOR
    PSK -->|"updateState()"| MARKETSTATE
    PSK -->|"settleP2PBatch(50)"| P2PTRADING
    PSK -->|"sweepLeftoverUSDC()"| P2PTRADING
    PSK -->|"endSettlement()"| COORDINATOR

    %% Frontend connections
    WSSERVER -->|"real-time ticks<br/>+ position updates"| CHART
    WSSERVER -->|"position updates"| TRADEPAGE
    RESTAPI -->|"OHLCV candles"| CHART
    RESTAPI -->|"positions API"| TRADEPAGE
    USER --> TRADEPAGE
    USER --> POOLPAGE
    USER --> GOVPAGE
    TRADEPAGE -->|"openPosition / closePosition / addCollateral"| TRADING
    TRADEPAGE -->|"openP2PPosition / closeP2PPosition"| P2PTRADING
    POOLPAGE -->|"deposit / withdraw"| POOL
    GOVPAGE -->|"propose / vote / execute"| GOVERNANCE

    %% Contract internal dependencies
    TRADING -->|"getPriceIfFresh"| ORACLE_SOL
    TRADING -->|"isMarketOpen"| MARKETSTATE
    TRADING -->|"calculateFee"| FEEMANAGER
    TRADING -->|"increase/decrease/increaseCollateral/pay<br/>totalTraderCollateral ±"| CUSTODY_GOLD
    TRADING -->|"receiveFees / absorbPnL"| POOL

    P2PTRADING -->|"swap / reverseSwap"| VAMM
    P2PTRADING -->|"isMarketOpen=NO"| MARKETSTATE
    P2PTRADING -->|"calculateFee"| FEEMANAGER
    P2PTRADING -->|"receiveFees"| POOL

    POOL -->|"addLiquidity /<br/>removeLiquidity"| CUSTODY_GOLD
    POOL -->|"addLiquidity /<br/>removeLiquidity"| CUSTODY_SILVER
    POOL -->|"addLiquidity /<br/>removeLiquidity"| CUSTODY_OIL
    POOL -->|"addLiquidity /<br/>removeLiquidity"| CUSTODY_PLAT
    POOL -->|"mint / burn"| PMLP

    GOVERNANCE -.->|"admin calls"| TRADING
    GOVERNANCE -.->|"admin calls"| POOL
    GOVERNANCE -.->|"admin calls"| ORACLE_SOL

    %% Styling
    classDef external fill:#4a1942,stroke:#e91e63,stroke-width:2px,color:#fff
    classDef oracle fill:#1a237e,stroke:#42a5f5,stroke-width:2px,color:#fff
    classDef frontend fill:#004d40,stroke:#26a69a,stroke-width:2px,color:#fff
    classDef contract fill:#b71c1c,stroke:#ef5350,stroke-width:1px,color:#fff
    classDef custody fill:#e65100,stroke:#ff9800,stroke-width:2px,color:#fff
    classDef token fill:#1b5e20,stroke:#66bb6a,stroke-width:1px,color:#fff
    classDef keeper fill:#311b92,stroke:#7c4dff,stroke-width:2px,color:#fff
    classDef database fill:#01579b,stroke:#29b6f6,stroke-width:2px,color:#fff

    class AUTONOM,USER external
    class FETCHER,PRICESTORE,CHAINPUSHER,MARKETDETECTOR,WSSERVER,RESTAPI oracle
    class COORDINATOR,FAK,LE,PT,PSK,PR keeper
    class TRADEPAGE,POOLPAGE,GOVPAGE,CHART frontend
    class ORACLE_SOL,MARKETSTATE,TRADING,P2PTRADING,VAMM,FEEMANAGER,POOL,GOVERNANCE contract
    class CUSTODY_GOLD,CUSTODY_SILVER,CUSTODY_OIL,CUSTODY_PLAT custody
    class USDC,PMLP,PRPMAN token
    class DB_TICKS,DB_CANDLES,DB_POSITIONS,DB_MARKET,DB_KEEPER database

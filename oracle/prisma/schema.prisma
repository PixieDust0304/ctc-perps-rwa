generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PriceTick {
  id        BigInt   @id @default(autoincrement())
  feedId    Int
  price     Decimal  @db.Decimal(78, 0)
  fresh     Boolean
  source    String   @default("oracle")
  timestamp DateTime

  @@index([feedId, timestamp])
}

model Candle {
  id        BigInt   @id @default(autoincrement())
  feedId    Int
  interval  String
  open      Decimal  @db.Decimal(78, 0)
  high      Decimal  @db.Decimal(78, 0)
  low       Decimal  @db.Decimal(78, 0)
  close     Decimal  @db.Decimal(78, 0)
  volume    Decimal  @default(0) @db.Decimal(78, 0)
  source    String   @default("oracle")
  timestamp DateTime

  @@unique([feedId, interval, timestamp])
  @@index([feedId, interval, timestamp(sort: Desc)])
}

model MarketStateLog {
  id        BigInt   @id @default(autoincrement())
  feedId    Int
  state     String
  price     Decimal? @db.Decimal(78, 0)
  reason    String?
  timestamp DateTime
}

model KeeperEvent {
  id           BigInt   @id @default(autoincrement())
  keeperType   String
  feedId       Int
  action       String
  positionId   String
  txHash       String?
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())
}

model PositionRecord {
  positionId  String    @id
  type        String
  owner       String
  feedId      Int
  isLong      Boolean
  collateral  Decimal   @db.Decimal(78, 0)
  sizeUsd     Decimal   @db.Decimal(78, 0)
  entryPrice  Decimal   @db.Decimal(78, 0)
  status      String    @default("open")
  realizedPnl Decimal?  @db.Decimal(78, 0)
  openedAt    DateTime
  closedAt    DateTime?
  txHash      String?
  closeTxHash String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([owner, status])
  @@index([feedId, status])
  @@index([status])
}
